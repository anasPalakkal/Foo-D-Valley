generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  favorites  Favorite[]
  recipes    Recipe[]
}

model Recipe {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  ingredients  String[]
  instructions String[]
  imageUrl     String?
  isExternal   Boolean  @default(false)  // true = from dummyjson, false = user uploaded
  externalId   Int?                      // dummyjson recipe id, if applicable
  createdAt    DateTime @default(now())

  authorId  Int
  author    User       @relation(fields: [authorId], references: [id])
  favorites Favorite[]
}

model Favorite {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())

  userId     Int
  user       User     @relation(fields: [userId], references: [id])

  // Internal recipe (nullable now — only set for user-uploaded recipes)
  recipeId   Int?
  recipe     Recipe?  @relation(fields: [recipeId], references: [id])

  // External recipe (TheMealDB)
  isExternal Boolean  @default(false)
  externalId String?
  externalName  String?
  externalImage String?

  @@unique([userId, recipeId])
  @@unique([userId, externalId])
}