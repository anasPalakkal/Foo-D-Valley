# Copy this file to .env and fill in real values. Never commit .env itself.

DATABASE_URL="postgresql://username:password@localhost:5432/foodvalley"

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be a long random hex string (128 chars), not a short/guessable phrase.
JWT_ACCESS_SECRET=

JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

PORT=5000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

BREVO_API_KEY=
EMAIL_FROM=

# Upstash Redis (https://upstash.com) - free tier used for rate limiting.
# Get these from: Upstash Console > your database > REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Must exactly match your frontend's origin (protocol + host + port, no trailing slash).
CLIENT_URL=http://localhost:5173

NODE_ENV=development
